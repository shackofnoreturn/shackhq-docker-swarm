{
  "service_name": "newservice",
  "description": "Boilerplate Swarm stack for new services",
  "version": "3.9",
  "files": {
    "compose": "docker-compose.yml",
    "env": ".env",
    "configs": ["configs/app_config.yaml"],
    "secrets": ["secrets/app_secret.txt"]
  },
  "defaults": {
    "replicas": 1,
    "limit_cpus": "0.5",
    "limit_memory": "512M"
  }
}
