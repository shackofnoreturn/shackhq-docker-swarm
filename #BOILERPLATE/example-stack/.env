# ---------------------------
# BASIC SERVICE INFO
# ---------------------------
SERVICE_NAME=myservice
IMAGE=myorg/myimage
IMAGE_TAG=latest
CONTAINER_NAME=myservice
HOSTNAME=myservice

# ---------------------------
# GENERAL SETTINGS
# ---------------------------
TZ=Europe/Brussels
PUID=1000
PGID=1000
UMASK=002
EXTRA_ENV_VAR=

# ---------------------------
# COMMAND / ENTRYPOINT
# ---------------------------
COMMAND=
ENTRYPOINT=

# ---------------------------
# RESOURCES
# ---------------------------
REPLICAS=1
LIMIT_CPUS=0.5
LIMIT_MEMORY=512M
RESERVE_CPUS=0.25
RESERVE_MEMORY=256M

# ---------------------------
# NETWORK
# ---------------------------
APP_PORT=8080
APP_PORT_PUBLISHED=8080
NFS_SERVER=10.0.0.30
NFS_PATH=/mnt/datapool01

# ---------------------------
# HEALTHCHECK
# ---------------------------
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=20s
