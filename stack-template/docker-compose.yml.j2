services:
{% for service_name, service in stack.services.items() %}
  {{ service_name }}:
    image: {{ service.image }}:{{ service.version }}
{% if service.ports %}
    ports:
{% for port in service.ports %}
      - target: {{ port.target }}
        published: {{ port.published }}
        protocol: tcp
        mode: host
{% endfor %}
{% endif %}
  configs:
    - source: app_config
      target: /etc/myapp/config.yaml
{% endfor %}

configs:
  app_config:
    file: ./configs/app_config.yml
