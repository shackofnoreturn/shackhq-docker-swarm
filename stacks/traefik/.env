# ── Traefik ──────────────────────────────
TRAEFIK_IMAGE=traefik:v3.5.1
TRAEFIK_REPLICAS=1
TRAEFIK_LOG_LEVEL=INFO         # DEBUG / INFO / WARN / ERROR
TRAEFIK_ACCESSLOG=true

# ── Entrypoints ─────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── Certificates ────────────────────────
TRAEFIK_CERT_RESOLVER=myresolver
ACME_EMAIL=shackofnoreturn@gmail.com

# ── Network ─────────────────────────────
TRAEFIK_NETWORK=traefik-dev

# ── Node constraints ────────────────────
CONSTRAINT_NODE_ROLE=manager
CONSTRAINT_NODE_ID=4
