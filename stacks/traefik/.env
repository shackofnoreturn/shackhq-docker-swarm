# Environment variables for Traefik stack
TRAEFIK_RESOLVER=letsencrypt

# Domain & email
TRAEFIK_DOMAIN=traefik.dev.shackofnoreturn.com
TRAEFIK_ACME_EMAIL=shackofnoreturn@gmail.com

# Optional basic auth user (e.g. generated by htpasswd)
# TRAEFIK_DASHBOARD_USER=admin
# TRAEFIK_DASHBOARD_PASS=hashedpassword
