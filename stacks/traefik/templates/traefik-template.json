{
  "service_name": "traefik",
  "description": "Standardized Swarm stack for Traefik v3.1 reverse proxy",
  "version": "3.9",
  "files": {
    "compose": "docker-compose.yml",
    "env": ".env",
    "configs": ["configs/traefik.yml"],
    "secrets": ["secrets/traefik-dashboard-auth"]
  },
  "defaults": {
    "replicas": 1,
    "limit_cpus": "0.5",
    "limit_memory": "512M"
  }
}
