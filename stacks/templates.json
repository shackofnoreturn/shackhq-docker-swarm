{
  "version": "3",
  "templates": [

    {
      "id": 1,
      "type": 2,
      "title": "Documentation (Wiki.js + Draw.io)",
      "description": "Central documentation portal with Wiki.js, PostgreSQL, and Draw.io",
      "categories": [ "Documentation" ],
      "platform": "linux",
      "logo": "https://raw.githubusercontent.com/Qballjos/portainer_templates/master/Images/wikijs.png",
      "note": "Deploys Wiki.js, Draw.io and PostgreSQL on a single manager node with label node_id == 4.\nMake sure the node has the label set: docker node update --label-add node_id=4 <NODE_NAME>.\nTraefik labels are included but commented out in the compose file.",
      "name": "documentation",
      "repository": {
        "url": "https://github.com/shackofnoreturn/shackhq-docker-swarm",
        "stackfile": "stacks/docs/docker-compose.docs.yml"
      },
      "env": [
        {
          "name": "STACK_NAME",
          "label": "Stack name",
          "default": "docs"
        },
        {
          "name": "WIKI_DOMAIN",
          "label": "Wiki.js domain",
          "default": "wiki.example.com"
        },
        {
          "name": "DRAWIO_DOMAIN",
          "label": "Draw.io domain",
          "default": "draw.example.com"
        },
        {
          "name": "DB_PASS",
          "label": "PostgreSQL password",
          "default": "wikijs_pass"
        },
        {
          "name": "TRAEFIK_RESOLVER",
          "label": "Traefik certresolver name",
          "default": "myresolver"
        }
      ]
    },

    {
      "id": 2,
      "type": 2,
      "title": "Traefik Reverse Proxy",
      "description": "Deploys Traefik v3.5.1 as a Swarm-aware reverse proxy with ACME support",
      "categories": ["Networking", "Proxy"],
      "platform": "linux",
      "logo": "https://doc.traefik.io/traefik/assets/img/traefik.logo.png",
      "note": "Deploy Traefik first so other stacks can join the traefik-dev network.",
      "name": "Traefik Stack",
      "repository": {
        "url": "https://github.com/shackofnoreturn/shackhq-docker-swarm",
        "stackfile": "stacks/traefik/docker-compose.traefik.yml"
      },
      "env": [
        { "name": "TRAEFIK_IMAGE",        "label": "Traefik image",         "default": "traefik:v3.5.1" },
        { "name": "TRAEFIK_LOG_LEVEL",    "label": "Log level",             "default": "INFO" },
        { "name": "TRAEFIK_ACCESSLOG",    "label": "Enable access log",     "default": "true" },
        { "name": "HTTP_PORT",            "label": "HTTP port",             "default": "80" },
        { "name": "HTTPS_PORT",           "label": "HTTPS port",            "default": "443" },
        { "name": "TRAEFIK_CERT_RESOLVER","label": "Cert resolver",         "default": "myresolver" },
        { "name": "ACME_EMAIL",           "label": "ACME email",            "default": "admin@example.com" },
        { "name": "ACME_STORAGE",         "label": "ACME storage path",     "default": "/letsencrypt/acme.json" },
        { "name": "TRAEFIK_NETWORK",      "label": "Overlay network name",  "default": "traefik-dev" },
        { "name": "TRAEFIK_REPLICAS",     "label": "Replicas",              "default": "1" },
        { "name": "CONSTRAINT_NODE_ROLE", "label": "Node role constraint",  "default": "manager" },
        { "name": "CONSTRAINT_NODE_ID",   "label": "Node ID label",         "default": "4" }
      ]
    }

  ]
}
