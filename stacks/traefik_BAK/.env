# ---------------------------
# BASIC SERVICE INFO
# ---------------------------
SERVICE_NAME=traefik
IMAGE=traefik
IMAGE_TAG=v3.1
CONTAINER_NAME=traefik
HOSTNAME=traefik

# ---------------------------
# GENERAL SETTINGS
# ---------------------------
TZ=Europe/Brussels
PUID=1000
PGID=1000
UMASK=002
EXTRA_ENV_VAR=

# ---------------------------
# COMMAND / ENTRYPOINT
# ---------------------------
COMMAND=
ENTRYPOINT=

# ---------------------------
# RESOURCES
# ---------------------------
REPLICAS=1
LIMIT_CPUS="0.5"
LIMIT_MEMORY=512M
RESERVE_CPUS=0.25
RESERVE_MEMORY=256M

# ---------------------------
# NETWORK
# ---------------------------
# TODO: Change to dev.shackofnoreturn.com
DOMAIN=dev.shackofnoreturn.com
ACME_EMAIL=shackofnoreturn@gmail.com

# ---------------------------
# HEALTHCHECK
# ---------------------------
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=20s
